# -----------------------------------------------------------------------------
# GHAR FOUNDATION - PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy these keys into your hosting provider's dashboard (e.g. Vercel, Railway, Render)
# -----------------------------------------------------------------------------

# 1. DATABASE CONFIGURATION (PostgreSQL / Neon / Supabase)
# For production, use pooled connection string (Neon or Supabase)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.neon.tech/gharfoundation?sslmode=require"

# 2. CLERK AUTHENTICATION (Production or Test keys)
# Get these from https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_..."
CLERK_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# 3. MEDIA STORAGE & CDN (ImageKit.io - Recommended for India CDN & unlimited transformations)
# Get these from https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PRIVATE_KEY="private_..."
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_..."
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_id"

# (Optional fallback) CLOUDINARY MEDIA STORAGE
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# 4. RATE LIMITING & CACHE (Optional Upstash Redis for distributed multi-instance serverless)
# Get these from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# 5. SERVER SESSION & HMAC ENCRYPTION SECRET
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-byte-base64-secret"

# 6. APP URL (Production domain)
NEXT_PUBLIC_APP_URL="https://gharfoundation.com"

# 7. TRANSACTIONAL EMAIL (Resend - Optional for tenant & owner alerts)
# Get your key from https://resend.com
RESEND_API_KEY="re_..."

# 8. NOTIFICATIONS (Firebase Cloud Messaging - Optional)
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_API_KEY=""
FIREBASE_PROJECT_ID=""

